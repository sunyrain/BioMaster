# Generated model and analysis outputs are local by default. Compact audited
# summaries may be force-added deliberately; already tracked snapshots remain
# tracked regardless of this rule.
/outputs/*
/configs/current_pipeline_v2.yaml

# The workspace contains many exploratory one-off programs. New scripts are
# ignored until deliberately promoted. Existing tracked scripts are unaffected.
/scripts/*.py

# Current comprehensive/bidirectional training and drug-centric evaluation
# dependency closure promoted during the 2026-08-26 repository audit.
!/scripts/audit_biomaster_comprehensive_balanced_v3.py
!/scripts/audit_drug_centric_kirhub_v1.py
